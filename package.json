{
  "name": "the-hollow-hour",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "THE HOLLOW HOUR \u2014 an original cinematic time-horror cluster-pays slot prototype (demo credits only).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "simulate": "tsx scripts/simulate.ts",
    "books": "tsx scripts/export-books.ts",
    "books:verify": "tsx scripts/verify-books.ts",
    "df:dev": "vite --config games/dead-frequency/vite.config.ts",
    "df:build": "tsc -b && vite build --config games/dead-frequency/vite.config.ts",
    "df:test": "vitest run --config games/dead-frequency/vite.config.ts",
    "df:simulate": "tsx games/dead-frequency/scripts/simulate.ts",
    "df:rtp": "tsx games/dead-frequency/scripts/rtp.ts",
    "df:books": "tsx games/dead-frequency/scripts/export-books.ts",
    "df:books:verify": "tsx games/dead-frequency/scripts/verify-books.ts",
    "df:stake:frontend": "vite build --config games/dead-frequency/vite.config.ts --outDir stake-upload/frontend --emptyOutDir",
    "df:replay-examples": "tsx games/dead-frequency/scripts/replay-examples.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.6",
    "@fontsource/cormorant-garamond": "^5.2.6",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
